# 默认按文本处理，统一成 LF，避免 Windows/macOS 混用产生无意义 diff
* text=auto eol=lf

# 源码与配置
*.c    text eol=lf
*.h    text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.csv  text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
sdkconfig text eol=lf

# Windows 脚本必须保留 CRLF，否则可能无法执行
*.bat  text eol=crlf
*.ps1  text eol=crlf

# 二进制资源
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.pt   binary
